    STATUS_NO_MERCURY: typing.ClassVar[java.lang.String] = ...
    STATUS_FAILED: typing.ClassVar[java.lang.String] = ...
    def getDissolvedMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getFreeMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getFreeMercuryState(self) -> java.lang.String: ...
    def getLabel(self) -> java.lang.String: ...
    def getMassFlowRate(self) -> float: ...
    @typing.overload
    def getMercuryConcentration(self, int: int, string: typing.Union[java.lang.String, str]) -> float: ...
    @typing.overload
    def getMercuryConcentration(self, string: typing.Union[java.lang.String, str], string2: typing.Union[java.lang.String, str]) -> float: ...
    def getMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getMercuryMoleFraction(self, int: int) -> float: ...
    def getNumberOfPhases(self) -> int: ...
