    @staticmethod
    def analyze(processSystem: jneqsim.process.processmodel.ProcessSystem) -> 'MercuryProcessReport': ...
    @typing.overload
    @staticmethod
    def setFreeMercuryAccumulation(processModel: jneqsim.process.processmodel.ProcessModel, boolean: bool) -> int: ...
    @typing.overload
    @staticmethod
    def setFreeMercuryAccumulation(processSystem: jneqsim.process.processmodel.ProcessSystem, boolean: bool) -> int: ...

class MercuryProcessReport(java.io.Serializable):
    def getFeedMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getFreeMercuryAccumulationRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getMaximumSaturationRatio(self) -> float: ...
    def getMercuryBalanceError(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getProductMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getRetainedMercuryFlowRate(self, string: typing.Union[java.lang.String, str]) -> float: ...
    def getStream(self, string: typing.Union[java.lang.String, str]) -> 'MercuryStreamResult': ...
    def getStreams(self) -> java.util.List['MercuryStreamResult']: ...
    def getStreamsWithFreeMercury(self) -> java.util.List['MercuryStreamResult']: ...
    def getUnit(self, string: typing.Union[java.lang.String, str]) -> 'MercuryUnitResult': ...
    def getUnits(self) -> java.util.List['MercuryUnitResult']: ...
    def hasFreeMercury(self) -> bool: ...
    def toJson(self) -> java.lang.String: ...

class MercuryStreamResult(java.io.Serializable):
