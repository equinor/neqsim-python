    def getPhaseNumber(self, string: typing.Union[java.lang.String, str]) -> int: ...
    def getPhaseType(self, int: int) -> java.lang.String: ...
    def getPressure(self) -> float: ...
    def getSaturationRatio(self) -> float: ...
    def getSourceUnit(self) -> java.lang.String: ...
    def getStatus(self) -> java.lang.String: ...
    def getStreamName(self) -> java.lang.String: ...
    def getTemperature(self) -> float: ...
    def hasFreeMercury(self) -> bool: ...
    def isFeed(self) -> bool: ...
    def isProduct(self) -> bool: ...

class MercuryUnitResult(java.io.Serializable):
