
import sys
if sys.version_info >= (3, 8):
    from typing import Protocol
else:
    from typing_extensions import Protocol

import java.lang
import java.util
import typing



class LegacyLoadRepairable:
    def repairAfterLegacyLoad(self, object: typing.Any) -> None: ...

class NeqSimXtream:
    PROCESS_ENTRY: typing.ClassVar[java.lang.String] = ...
    META_ENTRY: typing.ClassVar[java.lang.String] = ...
    FORMAT_VERSION: typing.ClassVar[java.lang.String] = ...
    def __init__(self): ...
    @staticmethod
    def getLastLoadReport() -> 'NeqSimXtream.LoadReport': ...
    @staticmethod
    def openNeqsim(string: typing.Union[java.lang.String, str]) -> typing.Any: ...
    @staticmethod
    def saveNeqsim(object: typing.Any, string: typing.Union[java.lang.String, str]) -> bool: ...
    class LoadReport:
        def getFieldsWithoutTemplate(self) -> java.util.Map[java.lang.String, int]: ...
        def getFilename(self) -> java.lang.String: ...
        def getIgnoredElements(self) -> java.util.Map[java.lang.String, int]: ...
        def getReadObjectHookFailures(self) -> java.util.Map[java.lang.String, int]: ...
        def getReadObjectHooks(self) -> java.util.Map[java.lang.String, int]: ...
        def getRenamedFields(self) -> java.util.Map[java.lang.String, int]: ...
        def getRestoredAsEmpty(self) -> java.util.Map[java.lang.String, int]: ...
        def getRestoredFields(self) -> java.util.Map[java.lang.String, int]: ...
        def getUnknownClasses(self) -> java.util.Map[java.lang.String, int]: ...
        def getWriterVersion(self) -> java.lang.String: ...
        def isClean(self) -> bool: ...
        def isLegacyFormat(self) -> bool: ...
        def toString(self) -> java.lang.String: ...

class SerializationManager:
    def __init__(self): ...
    @staticmethod
    def open(string: typing.Union[java.lang.String, str]) -> typing.Any: ...
    @staticmethod
    def save(object: typing.Any, string: typing.Union[java.lang.String, str]) -> None: ...


class __module_protocol__(Protocol):
    # A module protocol which reflects the result of ``jp.JPackage("jneqsim.util.serialization")``.

    LegacyLoadRepairable: typing.Type[LegacyLoadRepairable]
    NeqSimXtream: typing.Type[NeqSimXtream]
    SerializationManager: typing.Type[SerializationManager]
