class MercuryFluidConverter:
    @typing.overload
    @staticmethod
    def toUmrPruMc(systemInterface: jneqsim.thermo.system.SystemInterface) -> jneqsim.thermo.system.SystemInterface: ...
    @typing.overload
    @staticmethod
    def toUmrPruMc(systemInterface: jneqsim.thermo.system.SystemInterface, double: float, string: typing.Union[java.lang.String, str]) -> jneqsim.thermo.system.SystemInterface: ...

class MercuryPhaseEquilibrium(java.io.Serializable):
    MERCURY: typing.ClassVar[java.lang.String] = ...
    MELTING_TEMPERATURE: typing.ClassVar[float] = ...
    def __init__(self, systemInterface: jneqsim.thermo.system.SystemInterface): ...
    @staticmethod
    def convertMercuryConcentration(double: float, double2: float, double3: float, string: typing.Union[java.lang.String, str]) -> float: ...
    @staticmethod
    def convertMercuryFlow(double: float, double2: float, string: typing.Union[java.lang.String, str]) -> float: ...
    def getDissolvedMercuryMoles(self) -> float: ...
    def getFluid(self) -> jneqsim.thermo.system.SystemInterface: ...
    def getFreeMercuryFraction(self) -> float: ...
    def getFreeMercuryMoles(self) -> float: ...
    def getFreeMercuryState(self) -> java.lang.String: ...
    def getMercuryConcentration(self, int: int, string: typing.Union[java.lang.String, str]) -> float: ...
    def getMercuryMoleFraction(self, int: int) -> float: ...
    def getPhaseFraction(self, int: int) -> float: ...
    def getPureMercuryFugacity(self) -> float: ...
    def getSaturationRatio(self) -> float: ...
    def hasFreeMercury(self) -> bool: ...
    def run(self) -> None: ...


class __module_protocol__(Protocol):
    # A module protocol which reflects the result of ``jp.JPackage("jneqsim.thermo.util.mercury")``.

    MercuryFluidConverter: typing.Type[MercuryFluidConverter]
